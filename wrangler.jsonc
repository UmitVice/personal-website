{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umitvice",
  "account_id": "5d0c5657c5e6ef122e96439d9ddf0784",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "www.umitvice.com", "custom_domain": true },
    { "pattern": "umitvice.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false
}
